# Environment Configuration for Pump Predictor

# Environment
ENVIRONMENT=development

# API Configuration
API_HOST=localhost
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Security
SECRET_KEY=your_secret_key_here_change_in_production
API_KEY_ADMIN=admin_key_123_change_in_production
API_KEY_USER=user_key_456_change_in_production

# Database (if using)
DATABASE_URL=sqlite:///./pump_predictor.db

# Model Configuration
MODEL_DIR=models
DATA_DIR=data
LOG_DIR=logs
REPORT_DIR=reports

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# External Services
MONITORING_URL=
ALERT_WEBHOOK_URL=

# Performance
MAX_WORKERS=4
BATCH_SIZE=32
CACHE_TTL=3600

# Development
DEBUG=false
TESTING=false
